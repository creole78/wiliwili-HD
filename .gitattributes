# Normalize text files to LF in the repository, keep binary assets untouched.
* text=auto

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.7z binary
*.xz binary
*.gz binary
*.nro binary
*.vpk binary
*.a binary
*.o binary
*.bin binary

# Windows scripts are easier to read and edit with CRLF line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
