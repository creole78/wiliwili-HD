<brls:AppletFrame
        iconInterpolation="linear"
        headerHidden="true"
        footerHidden="false">
    <brls:Box
            axis="column"
            width="100%"
            height="100%">
        <AutoTabFrame
                id="main/tabFrame"
                grow="1"
                tabBackgroundColor="@theme/color/grey_1"
                tabItemActiveTextColor="@theme/color/bilibili"
                disableNavigationDown="true"
                defaultTab="0"
                sidebarPosition="left">

            <Tab label=""
                 fontSize="18"
                 icon="@res/svg/ico-home.svg"
                 iconActivate="@res/svg/ico-home-activate.svg">
                <HomeTab/>
            </Tab>

            <Tab label=""
                 fontSize="18"
                 icon="@res/svg/ico-dynamic.svg"
                 iconActivate="@res/svg/ico-dynamic-activate.svg">
                <DynamicTab/>
            </Tab>

            <Tab label=""
                 fontSize="18"
                 focusDown="main/desktop"
                 icon="@res/svg/ico-mine.svg"
                 iconActivate="@res/svg/ico-mine-activate.svg">
                <MineTab/>
            </Tab>
        </AutoTabFrame>
        <brls:Box
                wireframe="false"
                width="100"
                axis="column"
                justifyContent="center"
                alignItems="center"
                positionType="absolute"
                positionBottom="20">
            <CustomButton id="main/resume" focusable="true" visibility="gone"
                          axis="column" alignItems="center" width="80" height="70"
                          marginBottom="10" focusDown="main/desktop">
                <SVGImage width="32" height="32" SVG="@res/svg/ico-back.svg"/>
                <brls:Label text="@i18n/wiliwili/home/common/return_player" fontSize="17"/>
            </CustomButton>
            <CustomButton id="main/desktop" focusable="true" highlightCornerRadius="50"
                          cornerRadius="50" marginBottom="10" focusDown="main/exit">
                <SVGImage width="48" height="48" SVG="@res/svg/ico-minimize.svg"/>
            </CustomButton>
            <CustomButton id="main/exit" focusable="true" highlightCornerRadius="50"
                          cornerRadius="50" marginBottom="10" focusUp="main/desktop" focusDown="main/inbox">
                <SVGImage width="48" height="48" SVG="@res/svg/ico-close.svg"/>
            </CustomButton>
            <CustomButton
                id="main/inbox"
                focusable="true"
                highlightCornerRadius="50"
                cornerRadius="50"
                marginBottom="10"
                wireframe="false">
                <SVGImage
                        width="48"
                        height="48"
                        SVG="@res/svg/ico-inbox.svg"/>
            </CustomButton>

            <CustomButton
                    id="main/setting"
                    focusable="true"
                    highlightCornerRadius="50"
                    cornerRadius="50"
                    wireframe="false">
                <SVGImage
                        width="48"
                        height="48"
                        SVG="@res/svg/ico-setting.svg"/>
            </CustomButton>
        </brls:Box>
    </brls:Box>
</brls:AppletFrame>
